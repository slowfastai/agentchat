{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentchat.dev/schemas/relay/relay_envelope/v0.1.json",
  "title": "relay_envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "id",
    "timestamp",
    "from",
    "to",
    "channel_id",
    "seq",
    "ciphertext"
  ],
  "properties": {
    "type": { "const": "relay_envelope" },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "timestamp": { "type": "integer", "minimum": 0 },
    "from": {
      "type": "string",
      "pattern": "^(daemon|app:[A-Za-z0-9._-]{1,128})$"
    },
    "to": {
      "type": "string",
      "pattern": "^(daemon|app:[A-Za-z0-9._-]{1,128})$"
    },
    "channel_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22}$"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "ciphertext": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{16,}$"
    }
  }
}
